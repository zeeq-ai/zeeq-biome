# Public site URL, used for canonical links and OG tags (origin only; the base path comes from NUXT_APP_BASE_URL)
NUXT_PUBLIC_SITE_URL=https://zeeq-ai.github.io

# Base path the site is served from. GitHub Pages serves this repo under /zeeq-biome/;
# set to / for local dev and preview.
NUXT_APP_BASE_URL=/zeeq-biome/
