<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Zeeq.Biome</PackageId>
    <Description>Terse, readable test scenario setup: recreate your entity graph in miniature with blueprints, typed parent/child chaining, sequences, and a pluggable store.</Description>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../docs/public/logo.png" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="Zeeq.Biome.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference
      Include="../Zeeq.Biome.Generators/Zeeq.Biome.Generators.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
    <None
      Include="../Zeeq.Biome.Generators/bin/$(Configuration)/netstandard2.0/Zeeq.Biome.Generators.dll"
      Pack="true"
      PackagePath="analyzers/dotnet/cs"
      Visible="false"
    />
  </ItemGroup>
</Project>
