<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Package metadata shared by every packable project (src/**). -->
  <PropertyGroup>
    <Authors>Zeeq</Authors>
    <Company>Zeeq</Company>
    <Copyright>Copyright (c) Zeeq</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/zeeq-ai/zeeq-biome</PackageProjectUrl>
    <RepositoryUrl>https://github.com/zeeq-ai/zeeq-biome</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>testing;test-data;fixtures;seed;entity-graph;builder;efcore;tunit</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'"
      >true</ContinuousIntegrationBuild>
    <!-- Release builds pass -p:Version=X.Y.Z[-rc.N]; local builds use this placeholder. -->
    <Version>0.0.0-local</Version>
  </PropertyGroup>
</Project>
